<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1124">
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>50%</centertop>
			<height>420</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600"/>
				<param name="height" value="$VAR[DialogHeight4]"/>
				<param name="header_label" value="Manage Backups"/>
				<param name="header_id" value=""/>
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png"/>
			</include>
			<control type="panel" id="9000">
				<include content="ButtonMenuList_dialog">
					<param name="panel_height" value="280"/>
				</include>
				<onback>Dialog.Close(1124)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(FENtastic.DirectDialog1124),true)">ActivateWindow(1170)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(FENtastic.DirectDialog1124),true)">ClearProperty(FENtastic.DirectDialog1124,home)</onback>
				<onback condition="!String.IsEqual(Window(Home).Property(FENtastic.DirectDialog1124),true)">ActivateWindow(1123)</onback>
				<content>
					<item>
						<label>Backup</label>
						<onclick>Dialog.Close(1124)</onclick>
						<onclick>RunScript(script.fentastic.helper,mode=backup_config)</onclick>
					</item>
					<item>
						<label>Restore</label>
						<onclick>Dialog.Close(1124)</onclick>
						<onclick>RunScript(script.fentastic.helper,mode=restore_config)</onclick>
					</item>
					<item>
						<label>Import</label>
						<onclick>Dialog.Close(1124)</onclick>
						<onclick>RunScript(script.fentastic.helper,mode=import_config)</onclick>
					</item>
					<item>
						<label>Export</label>
						<onclick>Dialog.Close(1124)</onclick>
						<onclick>RunScript(script.fentastic.helper,mode=export_config)</onclick>
					</item>
				</content>
			</control>
		</control>
	</controls>
</window>
