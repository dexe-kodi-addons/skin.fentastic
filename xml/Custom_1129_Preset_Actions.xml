<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1129">
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>50%</centertop>
			<height>280</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600" />
				<param name="height" value="$VAR[DialogHeight2]" />
				<param name="header_label" value="Preset Actions" />
				<param name="header_id" value="" />
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png" />
			</include>
			<control type="panel" id="9000">
				<include content="ButtonMenuList_dialog">
					<param name="panel_height" value="140" />
				</include>
				<onback>Dialog.Close(1129)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(FENtastic.DirectDialog1129),true)">ActivateWindow(1170)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(FENtastic.DirectDialog1129),true)">ClearProperty(FENtastic.DirectDialog1129,home)</onback>
				<onback condition="!String.IsEqual(Window(Home).Property(FENtastic.DirectDialog1129),true)">ActivateWindow(1128)</onback>
				<content>
					<item>
						<label>Rename Preset</label>
						<onclick>Dialog.Close(1129)</onclick>
						<onclick>RunScript(script.fentastic.helper,mode=preset_rename)</onclick>
					</item>
					<item>
						<label>Delete Preset</label>
						<onclick>Dialog.Close(1129)</onclick>
						<onclick>RunScript(script.fentastic.helper,mode=preset_delete)</onclick>
					</item>
				</content>
			</control>
		</control>
	</controls>
</window>
