<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1126">
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>50%</centertop>
			<height>420</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600" />
				<param name="height" value="$VAR[DialogHeight4]" />
				<param name="header_label" value="Presets" />
				<param name="header_id" value="" />
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png" />
			</include>
			<control type="panel" id="9000">
				<include content="ButtonMenuList_dialog">
					<param name="panel_height" value="280" />
				</include>
				<onback>Dialog.Close(1126)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(FENtastic.DirectDialog1126),true)">ActivateWindow(1170)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(FENtastic.DirectDialog1126),true)">ClearProperty(FENtastic.DirectDialog1126,home)</onback>
				<onback condition="!String.IsEqual(Window(Home).Property(FENtastic.DirectDialog1126),true)">ActivateWindow(1106)</onback>
				<content>
					<item>
						<label>Featured Presets</label>
						<visible>[System.HasAddon(plugin.video.themoviedb.helper) | System.HasAddon(plugin.video.fenlight) | System.HasAddon(plugin.video.umbrella) | System.HasAddon(plugin.video.pov) | System.HasAddon(plugin.video.gears) | System.HasAddon(plugin.video.redlight)] + !Skin.HasSetting(Enable.PreMadeConfigs)</visible>
						
						<onclick>Dialog.Close(1126)</onclick>
						<onclick>ActivateWindow(1158)</onclick>
					</item>
					<item>
						<label>My Presets</label>
						<onclick>Dialog.Close(1126)</onclick>
						<onclick>RunScript(script.fentastic.helper,mode=select_quick_preset)</onclick>
					</item>
					<item>
						<label>Save Preset</label>
						<onclick>Dialog.Close(1126)</onclick>
						<onclick>RunScript(script.fentastic.helper,mode=save_quick_preset)</onclick>
					</item>
					<item>
						<label>Manage Presets</label>
						<onclick>Dialog.Close(1126)</onclick>
						<onclick>RunScript(script.fentastic.helper,mode=manage_quick_presets)</onclick>
					</item>
				</content>
			</control>
		</control>
	</controls>
</window>
