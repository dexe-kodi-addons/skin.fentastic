						<onclick>Dialog.Close(1107)</onclick>
						<onclick condition="String.IsEqual(Skin.String(current_search_provider),0)">ActivateWindow(10025,"plugin://plugin.video.themoviedb.helper/?info=search&amp;tmdb_type=tv")</onclick>
						<onclick condition="String.IsEqual(Skin.String(current_search_provider),1)">PlayMedia("plugin://plugin.video.fenlight/?mode=search.get_key_id&amp;media_type=tv_show&amp;isFolder=false&amp;iconImage=https%3A%2F%2Fraw.githubusercontent.com%2Fthejason40%2FFenLightPlus%2Fmain%2Ficons%2Fsearch_new.png")</onclick>
						<onclick condition="String.IsEqual(Skin.String(current_search_provider),2)">PlayMedia("plugin://plugin.video.umbrella/?action=tvSearchnew")</onclick>
						<onclick condition="String.IsEqual(Skin.String(current_search_provider),3)">PlayMedia("plugin://plugin.video.pov/?mode=get_search_term&amp;search_type=tvshow")</onclick>
